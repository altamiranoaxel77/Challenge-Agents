{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/Scripts/python -m reservas:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(pip install:*)",
      "Bash(*reiniciar-datos*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.db)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
